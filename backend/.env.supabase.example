# ===========================================
# Supabase Environment Configuration
# for H&B Trade
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# ===========================================
# Database Configuration (Supabase PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://postgres.REF:YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Direct connection (for server-side/backend)
DIRECT_URL=postgresql://postgres.REF:YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true

# Alternative individual params
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true

# ===========================================
# JWT Configuration - Generate with: npm run generate-secret
# ===========================================
JWT_SECRET=YOUR_SECURE_JWT_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRE=7d

# ===========================================
# Supabase Specific
# ===========================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===========================================
# Frontend URL (for CORS) - Your Vercel domain
# ===========================================
FRONTEND_URL=https://your-app.vercel.app

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info
