# ===========================================
# Frontend Environment Variables for Supabase + Vercel
# Copy this to .env.local for development
# Set these in Vercel Dashboard > Settings > Environment Variables
# ===========================================

# Backend API URL - Points to your deployed backend
# Option A: Backend on Render (keeping existing)
# NEXT_PUBLIC_API_URL=https://hbtrade-backend.onrender.com/api

# Option B: Backend on Supabase Edge Functions
# NEXT_PUBLIC_API_URL=https://[YOUR-PROJECT-REF].supabase.co/functions/v1/api

# Option C: Backend on Railway/other + Supabase DB only
# NEXT_PUBLIC_API_URL=https://your-backend-api.com/api

NEXT_PUBLIC_API_URL=https://your-backend-url/api

# ===========================================
# Supabase Client Config (for optional direct Supabase access)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
