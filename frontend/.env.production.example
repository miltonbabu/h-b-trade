# ===========================================
# Frontend Environment Variables for Vercel + Supabase
# for H&B Trade
# Backend: https://api.hbtrade.ltd
# ===========================================

# Backend API URL - Points to the live production backend
NEXT_PUBLIC_API_URL=https://api.hbtrade.ltd/api

# ===========================================
# Supabase Client Config (for optional direct Supabase access)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
